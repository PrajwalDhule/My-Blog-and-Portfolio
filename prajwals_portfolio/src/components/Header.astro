---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="links">
			<div class="internal-links">
				<HeaderLink href="https://prajwaldhule.netlify.app" target={"_blank"}>Portfolio</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://x.com/prajwaldhule36" target="_blank">
					X (Twitter)
				</a>
				<a href="https://linkedin.com/in/prajwal-dhule" target="_blank">
					Linkedin
				</a>
				<a href="https://github.com/PrajwalDhule" target="_blank">
					Github
				</a>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		top: 0;
		left: 0;
		width: min(720px, 100% - 2em);
		margin: 0 auto;
		padding: 1.5em 0;
		box-sizing: border-box;
	}
	h2 {
		margin: 0;
		font-size: 1.25em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: left;
	}
	nav a {
		padding: 1em 0;
		color: var(--black);
		text-decoration: none;
	}
	nav a:hover {
		color: white
	}
	nav a.active {
		text-decoration: none;
		color: var(--accent);;
	}
	nav a + a{
		margin-left: 1em;
	}
	nav .links{
		margin: 0 1em 0 auto;
		display: flex;
		align-items: center;
		gap: 1.25em;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		nav{
			flex-direction: column;
			align-items: flex-start;
		}
		nav .links {
			font-size: .8em;
			margin: 0;
		}
	}
</style>
