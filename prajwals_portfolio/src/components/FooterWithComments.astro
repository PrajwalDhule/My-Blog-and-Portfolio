---
import BaseFooterContent from "./BaseFooterContent.astro";
---

<footer>
	<div class="comment">
		<script src="https://giscus.app/client.js"
			data-repo="PrajwalDhule/My-Blog-and-Portfolio"
			data-repo-id="R_kgDOOhq9WQ"
			data-category="General"
			data-category-id="DIC_kwDOOhq9Wc4Cpqvd"
			data-mapping="pathname"
			data-strict="0"
			data-reactions-enabled="1"
			data-emit-metadata="0"
			data-input-position="bottom"
			data-theme="preferred_color_scheme"
			data-lang="en"
			crossorigin="anonymous"
		async>
		</script>
		<div class="giscus"></div>
	</div>
	<BaseFooterContent />
</footer>

<style>
    .comment{
        width: min(720px, 100%);
        margin: 0 auto;
    }
</style>
