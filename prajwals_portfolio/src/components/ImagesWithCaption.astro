---
import type { JSX } from "astro/jsx-runtime";

interface ImageItem {
  src: string;
  alt: string;
  width?: string;
}

const { images = [], caption = "" } = Astro.props as {
  images: ImageItem[];
  caption: JSX.Element;
};
---
<style>
    .image-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin: 0 auto;
    }

    .image-grid img {
        width: 360px;
    }

    @media (max-width: 768px) {
        .image-grid img {
            width: 40%;
        }
    }
    @media (max-width: 420px) {
        .image-grid img {
            width: 90%;
        }
    }

    .caption {
        width: min(690px, 100%);
        text-align: center;
        font-size: 0.75rem;
        margin: 0 auto 2.5em auto;
        color: #949494;
    }
</style>
 
<div>
    <div class="image-grid">
        {images.map((image, index) => (
            <img src={image.src} alt={image.alt || `Image ${index + 1}`} style={image.width ? `width: ${image.width}` : ""}/>
        ))}
    </div>
    <figcaption class="caption">
        <slot name="caption" />
    </figcaption>
</div>